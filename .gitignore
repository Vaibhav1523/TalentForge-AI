# Dependencies
node_modules/

# GCS service account keys (never commit)
.keys/

# Environment — use only .env (dev) and .env.production (prod); extra patterns ignore stray files
.env
.env.production
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local
.env.cloudrun
.env.cloudrun.yaml

# Next.js
.next/
out/

# Build / cache
dist/
build/
.cache/
*.tsbuildinfo
.turbo

# Testing
coverage/
.nyc_output/

# OS
.DS_Store
Thumbs.db

# Editor / IDE
.idea/
.vscode/
*.swp
*.swo
*~

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Debug
.npm
.yarn
.pnp
.pnp.js

# Chrome DevTools workspace (developer-local, not for VCS)
public/.well-known/appspecific/com.chrome.devtools.json

# Resumes - do not commit PII
public/uploads/resumes/*
!public/uploads/resumes/.gitkeep

# Optional local-only tooling tree (not tracked)
scripts/automation/

# Postman environment files may contain secrets (session tokens, API keys)
postman/*.postman_environment.json
.env*.local
