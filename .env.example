# ============================================
# NEXT.JS ENVIRONMENT VARIABLES - EXAMPLE
# ============================================
# Copy to .env for local development (gitignored). Production: .env.production only.
# Cloud Run: edit .env.production (do not set PORT/HOSTNAME there — Cloud Run sets PORT).
# Sync to Secret Manager: ./scripts/sync-dotenv-to-secret-manager.sh (strips PORT/HOST/HOSTNAME before upload).
# Local GCS key: ./scripts/create-hookstep-local-gcs-sa.sh → GOOGLE_APPLICATION_CREDENTIALS in .env only.
# CI optional: DOTENV_PRODUCTION_B64 to refresh the secret on deploy.
# ============================================

# ============================================
# NEXTAUTH
# ============================================
# Required - used by NextAuth for JWT/session signing
NEXTAUTH_SECRET=your_nextauth_secret_here_min_32_chars

# Dev: http://localhost:3000 — Prod (.env.production): https://your-domain
NEXTAUTH_URL=http://localhost:3000

# ============================================
# OAUTH PROVIDERS (optional; enable in auth config)
# ============================================
# Google: https://console.cloud.google.com/apis/credentials — Web client
# Redirect URIs must include (replace host with NEXTAUTH_URL):
#   {NEXTAUTH_URL}/api/auth/callback/google
# e.g. http://localhost:3000/api/auth/callback/google and https://hookstep.in/api/auth/callback/google
# NextAuth reads these on the server only (no NEXT_PUBLIC_ needed unless you add client-side Google APIs).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub: https://github.com/settings/developers
GITHUB_ID=
GITHUB_SECRET=

# LinkedIn: https://www.linkedin.com/developers/apps
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# ============================================
# DATABASE (SERVER-SIDE ONLY)
# ============================================
# Used by Prisma in API routes (runs on server)
# Get from MongoDB Atlas connection string
DATABASE_URL=mongodb+srv://username:password@cluster.mongodb.net/database?retryWrites=true&w=majority

# Local dev only (omit from .env.production / Secret Manager — Cloud Run injects PORT).
PORT=3000

# ============================================
# GOOGLE ADSENSE (monetization)
# ============================================
# Live account: pub-6574958062528034 (Auto ads enabled for hookstep.in).
# CLI: ./scripts/adsense-monetize.sh [--sync] [--deploy]
# /ads.txt is generated by src/app/ads.txt/route.ts
# NEXT_PUBLIC_ADSENSE_ENABLED=1
# NEXT_PUBLIC_ADSENSE_PUBLISHER_NUMERIC_ID=6574958062528034
# NEXT_PUBLIC_ADSENSE_HOME_FOOTER_SLOT=5342241888

# ============================================
# GOOGLE CLOUD STORAGE (Resume / CV uploads)
# ============================================
GCS_BUCKET_RESUMES=hireu-resumes-staging
# Optional: logos / team photos (see scripts/grant-cloud-run-bucket-access.sh)
# GCS_BUCKET_IMAGES=hookstep-logos-staging
# GCS_BUCKET_TEAM_PHOTOS=hookstep-team-photos-staging
# Cloud Run: omit GCS_SERVICE_ACCOUNT_JSON; run ./scripts/grant-cloud-run-bucket-access.sh (ADC).
# Local: npm run env:local-gcs-sa — then GOOGLE_APPLICATION_CREDENTIALS=.keys/hookstep-local-gcs.json in .env

# ============================================
# APP / EMAIL / AI (server-side)
# ============================================
NEXT_PUBLIC_APP_DOMAIN=your-domain.com
RESEND_API_KEY=
EMAIL_FROM=
CAL_WEBHOOK_SECRET=
RECRUITER_ALLOWLIST_EMAILS=
RECRUITER_ID=
ADMIN_EMAILS=
SUPER_ADMIN_EMAIL=
GEMINI_API_KEY=
BLAND_API_KEY=

# ============================================
# SECURITY NOTES
# ============================================
# ✅ These secrets are SAFE in Next.js .env because:
#    - Next.js .env loads on the NODE.JS SERVER
#    - Only NEXT_PUBLIC_ variables go to browser
#    - Middleware runs on server (not browser)
#    - API routes run on server (not browser)
#
# ❌ NEVER do this:
#    - NEXT_PUBLIC_* for server-only secrets (exposes them to the browser)
#    - Hardcode secrets in components
#    - Commit .env to Git
#
# ℹ️  Next.js is a FULL-STACK framework:
#    - It has a Node.js server backend
#    - It can safely store secrets like any backend
#    - Only NEXT_PUBLIC_ vars are bundled to client
# ============================================
